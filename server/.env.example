# Node.js API
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/smartdraw
JWT_SECRET=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development

# Python AI gateway（server.py 也读取本文件）
AI_HOST=127.0.0.1
AI_PORT=8000
AI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
UPSTREAM_TIMEOUT_SECONDS=60

# 腾讯混元
HUNYUAN_API_KEY=
HUNYUAN_API_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest

# OpenAI；如使用兼容服务，请显式修改 Base URL 和模型名。
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
